<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvEditTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/alarm_edit_title_new"
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:letterSpacing="0.3"
            android:fontFamily="monospace"
            android:layout_marginBottom="4dp"/>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border"
            android:layout_marginBottom="32dp"/>

        <!-- Time picker card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_time"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <NumberPicker
                    android:id="@+id/npHour"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time_separator"
                    android:textSize="40sp"
                    android:textColor="@color/accent"
                    android:paddingHorizontal="16dp"
                    android:fontFamily="monospace"/>

                <NumberPicker
                    android:id="@+id/npMinute"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"/>

            </LinearLayout>
        </LinearLayout>

        <!-- Label card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_label"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:layout_marginBottom="12dp"/>

            <EditText
                android:id="@+id/etLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/alarm_label_hint"
                android:inputType="text"
                android:importantForAutofill="no"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:background="@drawable/bg_input"
                android:padding="12dp"
                android:textSize="16sp"/>

        </LinearLayout>

        <!-- Repeat card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:layout_marginBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/section_repeat"
                android:textColor="@color/text_secondary"
                android:textSize="11sp"
                android:letterSpacing="0.2"
                android:layout_marginBottom="12dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="8">

                <CheckBox android:id="@+id/cbMon"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/day_mon"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"/>
                <CheckBox android:id="@+id/cbTue"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/day_tue"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"/>
                <CheckBox android:id="@+id/cbWed"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/day_wed"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"/>
                <CheckBox android:id="@+id/cbThu"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/day_thu"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"/>
                <CheckBox android:id="@+id/cbFri"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/day_fri"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"/>
                <CheckBox android:id="@+id/cbSat"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/day_sat"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"/>
                <CheckBox android:id="@+id/cbSun"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/day_sun"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"/>
                <CheckBox android:id="@+id/cbWeekly"
                    android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:text="@string/day_all"
                    android:textSize="11sp"
                    android:textColor="@color/text_primary"
                    android:buttonTint="@color/accent"
                    android:minWidth="0dp"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"/>

            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/btnSetQR"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/qr_not_set"
            android:textColor="@color/bg_primary"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:background="@drawable/bg_button_accent"
            android:layout_marginBottom="10dp"/>

        <Button
            android:id="@+id/btnRingtones"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/btn_add_ringtones"
            android:textColor="@color/bg_primary"
            android:textSize="12sp"
            android:letterSpacing="0.1"
            android:background="@drawable/bg_button_accent"
            android:layout_marginBottom="24dp"/>

        <Button
            android:id="@+id/btnSaveAlarm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/btn_save_alarm"
            android:textColor="@color/bg_primary"
            android:textSize="13sp"
            android:letterSpacing="0.15"
            android:background="@drawable/bg_button_accent"/>

    </LinearLayout>
</ScrollView>
